{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "loopback-app",
  "description": "Allow the packaged loopback frontend to open validated links and save generated files",
  "windows": ["main"],
  "local": false,
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": ["allow-open-external", "allow-save-download"]
}
