{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SignalRank",
  "version": "0.2.2",
  "identifier": "app.signalrank.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:services",
    "beforeBuildCommand": "npm run build:web && npm run stage:sidecars",
    "devUrl": "http://127.0.0.1:3000",
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SignalRank",
        "width": 1280,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 720,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "resources": {
      "../dist/web": "web",
      "node-libs": "node-libs"
    },
    "externalBin": [
      "binaries/signalrank-backend",
      "binaries/signalrank-web"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Local-first job discovery and ranking",
    "longDescription": "SignalRank scrapes, stores, and ranks jobs locally using user-provided OpenRouter access.",
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    }
  },
  "plugins": {
    "shell": {
      "open": false
    }
  }
}
