# OpenRouter API key — required for AI config advisor (post-batch LLM suggestions)
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# SerpAPI key — fallback for recruiter LinkedIn search when DDG is throttled
# Free tier: 100 searches/month — https://serpapi.com/
SERPAPI_KEY=
# Set to false to disable SerpAPI even if key is present
SERPAPI_ENABLED=true

# Brave Search API key — fallback for recruiter LinkedIn search (better free tier)
# Free tier: 2000 req/month — https://brave.com/search/api/
BRAVE_API_KEY=

# Bing Web Search API key — last-resort fallback for recruiter search
# Free tier: 1000 req/month — https://portal.azure.com → Cognitive Services → Bing Search
BING_SEARCH_KEY=
